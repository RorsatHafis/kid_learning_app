# Build output (frontend/.gitignore also covers node_modules and dist)
backend/target/
# Media uploaded while developing locally (MEDIA_ROOT fallback, application-local.yml)
backend/media/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# JVM crash / compiler replay artifacts
hs_err_pid*.log
replay_pid*.log

# Local environment files - templates (.env.example) stay tracked
.env
.env.*
!.env.example
# Production settings hold secrets (deploy/production.settings.example is the tracked template)
deploy/*.settings
# Backups made by scripts/backup.sh in the working tree hold real data
/backups/

# IDE / OS state
.idea/
*.iml
.vscode/
.DS_Store

# Claude Code per-user settings (the shared .claude/ project config is tracked)
.claude/settings.local.json

# Checkpoint archives, superseded by git history
*.zip

# Impeccable working files (decision pages, reviews)
.impeccable/questions/
.impeccable/review/
.impeccable/mocks/
.impeccable/decision-*.json

# Local preview launch configuration (per machine)
.claude/launch.json
