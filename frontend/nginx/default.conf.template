# Bookeyond Kid web front: static app + /api reverse proxy.
# A template: at start the nginx image fills in ${BACKEND_ORIGIN} (the backend's address inside the
# container network; Dockerfile default http://backend:8080) and ${NGINX_LOCAL_RESOLVERS} (the
# container's own DNS servers). Only variables set in the environment are replaced, so nginx's own
# $host, $remote_addr and the like are left alone.

# The port the browser used (from its Host header; none when it is the scheme's default), passed on as
# X-Forwarded-Port so the backend knows its public address exactly - same-origin requests are then
# recognised as such on any port.
map $http_host $forwarded_port {
    ~:(?<port>[0-9]+)$ $port;
    default "";
}

# The scheme the browser used: what a TLS proxy in front says (X-Forwarded-Proto), else this server's own.
# Behind such a proxy the app is https although this nginx is reached over http; the backend must know,
# or the app's own requests would look like they came from another origin.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    # The backend is looked up when requests arrive (an answer is kept 2 s), not once at start: a
    # backend replaced on a new address - a redeploy, a restart, a rescheduled container - is reached
    # again within 2 s by itself, and the web front starts even while the backend is still down (502
    # until it is up). The lookup goes to the container's own DNS, so asking that often costs nothing.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=2s ipv6=off;
    set $backend_origin ${BACKEND_ORIGIN};
    root /usr/share/nginx/html;

    # API requests are small JSON bodies; the one upload (Studio media) has its own limit below.
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        # The address as the browser wrote it, port included: the backend then sees the app's own
        # pages as the same origin however the app is reached (another port, a LAN address).
        proxy_set_header Host $http_host;
        # This proxy is the edge: it replaces, never appends to, whatever the client sent,
        # so the backend's per-client limits see the real address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # X11: pictures and recordings uploaded in the Content Studio (at most 5 MB each; the
    # backend inspects and limits them too).
    location = /api/v1/studio/media {
        client_max_body_size 6m;
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Media by signed URL: the backend's own caching (private, until the URL expires) and
    # range handling (audio) pass through untouched.
    location /api/v1/media/ {
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Vite puts a content hash in every asset name, so they can be cached for good.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Every other path is the single-page app; the page itself is always revalidated so a
    # new release is picked up on the next visit.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
