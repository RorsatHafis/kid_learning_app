# Copy this file to .env for local development. Do not use these values outside a local machine.
POSTGRES_DB=learning_platform
POSTGRES_USER=learning_platform
POSTGRES_PASSWORD=learning_platform

# Optional: override when PostgreSQL runs somewhere other than Docker Compose.
DB_URL=jdbc:postgresql://localhost:5433/learning_platform

MINIO_ROOT_USER=learning_platform
MINIO_ROOT_PASSWORD=learning_platform_dev

# Optional application configuration
JWT_ISSUER=yulme-api
JWT_ACCESS_TOKEN_TTL=15m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
MASTERY_LEARNING_RATE=0.2
MASTERY_CONFIDENCE_SATURATION_COUNT=10
MASTERY_OBJECTIVE_THRESHOLD=0.8

# Comma-separated list of origins the frontend is served from. Defaults to the
# Vite dev server port if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
